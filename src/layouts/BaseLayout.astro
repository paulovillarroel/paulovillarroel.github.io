---
import { Font } from 'astro:assets';
import { HTML_LANG, type Locale, type RouteKey } from '@/i18n/config';
import { ui } from '@/i18n/ui';
import SEO from '@/components/SEO.astro';
import JsonLd from '@/components/JsonLd.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import '@/styles/global.css';

interface Props {
  lang: Locale;
  routeKey: RouteKey;
  title: string;
  description: string;
  noindex?: boolean;
}

const { lang, routeKey, title, description, noindex } = Astro.props;
---

<!doctype html>
<html lang={HTML_LANG[lang]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/icon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    {/* Preload only what paints above the fold. Spanish accents all live in
        the `latin` subset, so `latin-ext` can load lazily from CSS. */}
    <Font cssVariable="--font-serif" preload={[{ subset: 'latin' }]} />
    <Font cssVariable="--font-sans" preload={[{ subset: 'latin', style: 'normal' }]} />
    <Font cssVariable="--font-mono" />

    <SEO lang={lang} routeKey={routeKey} title={title} description={description} noindex={noindex} />
    <JsonLd lang={lang} routeKey={routeKey} title={title} description={description} />
  </head>

  <body>
    <a class="skip-link" href="#main">{ui.skipToContent[lang]}</a>
    <Header lang={lang} routeKey={routeKey} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>

<style is:global>
  main {
    flex: 1;
  }

  main:focus {
    outline: none;
  }
</style>
