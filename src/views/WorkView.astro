---
import type { Locale } from '@/i18n/config';
import { ui } from '@/i18n/ui';
import { PROJECTS, STRATEGIC_PROGRAMME } from '@/data/projects';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/PageHeader.astro';
import Section from '@/components/Section.astro';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;

const copy = {
  metaTitle: { es: 'Proyectos', en: 'Projects' },
  metaDescription: {
    es: 'Modelos de IA para listas de espera, detección de cáncer oculto en demanda quirúrgica, record linkage nacional y arquitectura analítica frugal con DuckDB en el Ministerio de Salud de Chile.',
    en: 'AI models for waiting lists, detection of hidden cancer in surgical demand, national record linkage and frugal analytics architecture with DuckDB at the Chilean Ministry of Health.',
  },
  eyebrow: { es: 'Trabajo técnico', en: 'Technical work' },
  title: {
    es: 'Sistemas que buscan a los pacientes que el sistema pierde',
    en: 'Systems that look for the patients the system loses',
  },
  lede: {
    es: 'Cinco proyectos, doce años y una sola pregunta: dónde están las personas que la burocracia sanitaria dejó de contar. Las herramientas cambiaron —de una etiqueta fluorescente sobre una ficha de papel a un modelo de lenguaje sobre millones de derivaciones—, el objetivo no.',
    en: 'Five projects, twelve years and a single question: where are the people that health bureaucracy stopped counting. The tools changed — from a fluorescent sticker on a paper chart to a language model over millions of referrals — the goal did not.',
  },
  indexTitle: { es: 'Índice', en: 'Index' },
  nowEyebrow: { es: 'En curso', en: 'In progress' },
} as const;
---

<BaseLayout
  lang={lang}
  routeKey="work"
  title={copy.metaTitle[lang]}
  description={copy.metaDescription[lang]}
>
  <PageHeader eyebrow={copy.eyebrow[lang]} title={copy.title[lang]} lede={copy.lede[lang]}>
    <nav class="index" aria-label={copy.indexTitle[lang]}>
      <ol>
        {
          PROJECTS.map((project, i) => (
            <li>
              <a class="index-link" href={`#${project.id}`}>
                <span class="index-num mono">{String(i + 1).padStart(2, '0')}</span>
                <span class="index-text">{project.title[lang]}</span>
                <span class="index-year mono">{project.period}</span>
              </a>
            </li>
          ))
        }
      </ol>
    </nav>
  </PageHeader>

  {
    PROJECTS.map((project, i) => (
      <Section sunk={i % 2 === 1} id={project.id}>
        <article class="project">
          <header class="project-head">
            <p class="eyebrow">
              {project.period} · {project.org[lang]}
            </p>
            <h2 class="project-title">{project.title[lang]}</h2>
            <p class="lede project-tagline">{project.tagline[lang]}</p>
            <p class="project-role mono muted">
              {ui.labels.role[lang]}: {project.role[lang]}
            </p>
          </header>

          <div class="project-body">
            <div class="block">
              <h3 class="block-title">{ui.labels.context[lang]}</h3>
              <p class="block-text">{project.context[lang]}</p>
            </div>

            <div class="block">
              <h3 class="block-title">{ui.labels.approach[lang]}</h3>
              <ul class="block-list">
                {project.approach[lang].map((item) => <li>{item}</li>)}
              </ul>
            </div>

            <div class="block">
              <h3 class="block-title">{ui.labels.impact[lang]}</h3>
              <ul class="block-list outcome">
                {project.outcome[lang].map((item) => <li>{item}</li>)}
              </ul>
            </div>
          </div>

          <footer class="project-foot">
            <h3 class="block-title">{ui.labels.stack[lang]}</h3>
            <ul class="chips">
              {project.stack.map((item) => <li class="chip mono">{item}</li>)}
            </ul>
          </footer>
        </article>
      </Section>
    ))
  }

  <Section
    id="programa-2026"
    eyebrow={copy.nowEyebrow[lang]}
    title={STRATEGIC_PROGRAMME.title[lang]}
    lede={STRATEGIC_PROGRAMME.intro[lang]}
  >
    <ol class="programme">
      {
        STRATEGIC_PROGRAMME.projects.map((project, i) => (
          <li class="programme-item">
            <span class="programme-index mono">{String(i + 1).padStart(2, '0')}</span>
            <div>
              <h3 class="programme-title">{project.title[lang]}</h3>
              <p class="muted programme-body">{project.body[lang]}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </Section>
</BaseLayout>

<style>
  /* ---- Index ---- */
  .index ol {
    list-style: none;
    padding: 0;
    margin: 0;
    border-block-start: 1px solid var(--line);
    max-width: 52rem;
  }

  .index-link {
    display: grid;
    grid-template-columns: 2.5rem minmax(0, 1fr) auto;
    gap: 0.75rem;
    align-items: baseline;
    padding-block: 0.85rem;
    border-block-end: 1px solid var(--line);
    text-decoration: none;
    color: var(--ink-2);
    transition: color 0.18s var(--ease), padding-inline-start 0.18s var(--ease);
  }

  .index-link:hover {
    color: var(--accent-deep);
    padding-inline-start: 0.35rem;
  }

  .index-num {
    color: var(--accent);
    font-size: 0.72rem;
  }

  .index-text {
    font-size: var(--step--1);
    font-weight: 500;
  }

  .index-year {
    font-size: 0.72rem;
    color: var(--ink-3);
  }

  /* ---- Project ---- */
  .project-head {
    max-width: 46rem;
    /* Clears the sticky header when jumping in from the index. */
    scroll-margin-block-start: 6rem;
  }

  .project-title {
    margin-block-start: 0.6rem;
    font-size: var(--step-3);
  }

  .project-tagline {
    margin-block-start: 1rem;
  }

  .project-role {
    margin-block-start: 1rem;
    font-size: 0.74rem;
    letter-spacing: 0.03em;
    line-height: 1.6;
  }

  .project-body {
    display: grid;
    gap: clamp(1.75rem, 1.2rem + 2.4vw, 3rem);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 19rem), 1fr));
    margin-block-start: clamp(2.25rem, 1.8rem + 2vw, 3.25rem);
    padding-block-start: clamp(2rem, 1.6rem + 1.6vw, 2.75rem);
    border-block-start: 1px solid var(--line-strong);
  }

  .block-title {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-3);
    margin-block-end: 0.85rem;
  }

  .block-text {
    color: var(--ink-2);
    font-size: var(--step--1);
    line-height: 1.75;
  }

  .block-list {
    display: grid;
    gap: 0.75rem;
    padding-inline-start: 0;
    margin: 0;
    list-style: none;
    color: var(--ink-2);
    font-size: var(--step--1);
    line-height: 1.7;
  }

  .block-list li {
    padding-inline-start: 1.1rem;
    position: relative;
  }

  .block-list li::before {
    content: '';
    position: absolute;
    inset-inline-start: 0;
    inset-block-start: 0.62em;
    width: 0.4rem;
    height: 1px;
    background: var(--line-strong);
  }

  .block-list.outcome li::before {
    background: var(--accent);
    height: 2px;
  }

  .project-foot {
    margin-block-start: clamp(1.75rem, 1.4rem + 1.4vw, 2.5rem);
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .chip {
    padding: 0.22rem 0.6rem;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    color: var(--ink-2);
    font-size: 0.72rem;
    background: var(--surface);
  }

  /* ---- 2026 programme ---- */
  .programme {
    display: grid;
    gap: 1.5rem clamp(1.5rem, 1rem + 2vw, 2.75rem);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr));
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .programme-item {
    display: flex;
    gap: 0.85rem;
    padding-block-start: 1rem;
    border-block-start: 1px solid var(--line-strong);
  }

  .programme-index {
    color: var(--accent);
    font-size: 0.72rem;
    padding-block-start: 0.25rem;
    flex: none;
  }

  .programme-title {
    font-family: var(--font-sans);
    font-size: var(--step-0);
    font-weight: 600;
    letter-spacing: 0;
    line-height: 1.4;
  }

  .programme-body {
    font-size: var(--step--1);
    line-height: 1.6;
    margin-block-start: 0.3rem;
  }
</style>
