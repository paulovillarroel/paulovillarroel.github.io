---
import type { Locale } from '@/i18n/config';
import { ui } from '@/i18n/ui';
import { METHOD_GROUPS, PROJECTS, STRATEGIC_PROGRAMME } from '@/data/projects';
import { APPS } from '@/data/apps';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/PageHeader.astro';
import Section from '@/components/Section.astro';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;

const copy = {
  metaTitle: { es: 'Proyectos', en: 'Projects' },
  metaDescription: {
    es: 'Inteligencia artificial y analítica avanzada en el Ministerio de Salud de Chile: clasificación oncológica con NLP y gradient boosting, modelos de lenguaje afinados con QLoRA, detección de anomalías, record linkage probabilístico y anonimización con k-anonimidad.',
    en: 'Artificial intelligence and advanced analytics at the Chilean Ministry of Health: cancer classification with NLP and gradient boosting, language models fine-tuned with QLoRA, anomaly detection, probabilistic record linkage and k-anonymity anonymisation.',
  },
  eyebrow: { es: 'Trabajo técnico', en: 'Technical work' },
  title: {
    es: 'Sistemas que buscan a los pacientes que el sistema pierde',
    en: 'Systems that look for the patients the system loses',
  },
  lede: {
    es: 'Doce años y una sola pregunta: dónde están las personas que la burocracia sanitaria dejó de contar. Las herramientas cambiaron —de una etiqueta fluorescente sobre una ficha de papel a un modelo de lenguaje afinado sobre millones de derivaciones—, el objetivo no.',
    en: 'Twelve years and a single question: where are the people that health bureaucracy stopped counting. The tools changed — from a fluorescent sticker on a paper chart to a fine-tuned language model over millions of referrals — the goal did not.',
  },
  indexTitle: { es: 'Índice', en: 'Index' },
  nowEyebrow: { es: 'En curso', en: 'In progress' },
  methodsEyebrow: { es: 'Métodos', en: 'Methods' },
  methodsTitle: { es: 'Superficie técnica', en: 'Technical surface' },
  methodsLede: {
    es: 'Cada método de esta lista está en uso en alguno de los sistemas que siguen. No es un inventario de familiaridad.',
    en: 'Every method listed here is in use in one of the systems below. It is not a familiarity inventory.',
  },
  problem: { es: 'El problema', en: 'The problem' },
  architecture: { es: 'Arquitectura', en: 'Architecture' },
  repo: { es: 'Código', en: 'Code' },
  appsEyebrow: { es: 'Aplicaciones', en: 'Applications' },
  appsTitle: { es: 'Software que construí y mantengo', en: 'Software I built and maintain' },
  appsLede: {
    es: 'Herramientas propias con despliegue en funcionamiento. Donde el repositorio es público, está enlazado.',
    en: 'Tools of my own with a running deployment. Where the repository is public, it is linked.',
  },
  visit: { es: 'Ver el sitio', en: 'Visit' },
  how: { es: 'Cómo funciona', en: 'How it works' },
  produced: { es: 'Qué produjo', en: 'What it produced' },
  evaluation: { es: 'Evaluación', en: 'Evaluation' },
  colParam: { es: 'Parámetro', en: 'Parameter' },
  colValue: { es: 'Rendimiento', en: 'Result' },
  colImplication: { es: 'Implicancia asistencial', en: 'Clinical implication' },
} as const;
---

<BaseLayout
  lang={lang}
  routeKey="work"
  title={copy.metaTitle[lang]}
  description={copy.metaDescription[lang]}
>
  <PageHeader eyebrow={copy.eyebrow[lang]} title={copy.title[lang]} lede={copy.lede[lang]}>
    <nav class="index" aria-label={copy.indexTitle[lang]}>
      <ol>
        <li>
          <a class="index-link" href="#metodos">
            <span class="index-num mono">00</span>
            <span class="index-text">{copy.methodsTitle[lang]}</span>
            <span class="index-year mono">{copy.methodsEyebrow[lang]}</span>
          </a>
        </li>
        {
          PROJECTS.map((project, i) => (
            <li>
              <a class="index-link" href={`#${project.id}`}>
                <span class="index-num mono">{String(i + 1).padStart(2, '0')}</span>
                <span class="index-text">{project.title[lang]}</span>
                <span class="index-year mono">{project.period}</span>
              </a>
            </li>
          ))
        }
        <li>
          <a class="index-link" href="#aplicaciones">
            <span class="index-num mono">{String(PROJECTS.length + 1).padStart(2, '0')}</span>
            <span class="index-text">{copy.appsTitle[lang]}</span>
            <span class="index-year mono">{copy.appsEyebrow[lang]}</span>
          </a>
        </li>
      </ol>
    </nav>
  </PageHeader>

  <Section
    sunk
    id="metodos"
    eyebrow={copy.methodsEyebrow[lang]}
    title={copy.methodsTitle[lang]}
    lede={copy.methodsLede[lang]}
  >
    <div class="methods">
      {
        METHOD_GROUPS.map((group) => (
          <section class="method-group">
            <h3 class="method-title">{group.title[lang]}</h3>
            <ul class="method-list">
              {group.items.map((item) => <li>{item}</li>)}
            </ul>
          </section>
        ))
      }
    </div>
  </Section>

  {
    PROJECTS.map((project, i) => (
      <Section sunk={i % 2 === 0} id={project.id}>
        <article class="project">
          <div class="rail">
            <p class="rail-period mono">{project.period}</p>
            <p class="rail-org">{project.org[lang]}</p>

            <dl class="rail-meta">
              <dt>{ui.labels.role[lang]}</dt>
              <dd>{project.role[lang]}</dd>
              <dt>{ui.labels.stack[lang]}</dt>
              <dd>
                <ul class="chips">
                  {project.stack.map((item) => <li class="chip mono">{item}</li>)}
                </ul>
              </dd>
              {
                project.repo && (
                  <>
                    <dt>{copy.repo[lang]}</dt>
                    <dd>
                      <a class="link mono" href={project.repo} rel="noopener" target="_blank">
                        GitHub ↗
                      </a>
                    </dd>
                  </>
                )
              }
            </dl>
          </div>

          <div class="body">
            <h2 class="project-title">{project.title[lang]}</h2>
            <p class="lede project-tagline">{project.tagline[lang]}</p>

            <section class="block">
              <h3 class="block-title">{copy.problem[lang]}</h3>
              <p class="block-text">{project.context[lang]}</p>
            </section>

            {
              project.architecture && (
                <section class="block">
                  <h3 class="block-title">{copy.architecture[lang]}</h3>
                  <ol class="flow">
                    {project.architecture.map((step) => (
                      <li class="flow-step">
                        <span class="flow-stage mono">{step.stage[lang]}</span>
                        <span class="flow-detail">{step.detail[lang]}</span>
                      </li>
                    ))}
                  </ol>
                </section>
              )
            }

            <section class="block">
              <h3 class="block-title">{copy.produced[lang]}</h3>
              <ul class="outcomes">
                {project.outcome[lang].map((item) => <li>{item}</li>)}
              </ul>
            </section>

            {
              project.metrics && (
                <section class="block">
                  <h3 class="block-title">{copy.evaluation[lang]}</h3>
                  <div class="table-wrap">
                    <table class="table">
                      <thead>
                        <tr>
                          <th scope="col">{copy.colParam[lang]}</th>
                          <th scope="col">{copy.colValue[lang]}</th>
                          <th scope="col">{copy.colImplication[lang]}</th>
                        </tr>
                      </thead>
                      <tbody>
                        {project.metrics.map((metric) => (
                          <tr>
                            <th scope="row">{metric.param[lang]}</th>
                            <td class="metric-value mono">{metric.value[lang]}</td>
                            <td class="muted">{metric.implication[lang]}</td>
                          </tr>
                        ))}
                      </tbody>
                    </table>
                  </div>
                </section>
              )
            }
          </div>
        </article>
      </Section>
    ))
  }

  <Section
    sunk
    id="aplicaciones"
    eyebrow={copy.appsEyebrow[lang]}
    title={copy.appsTitle[lang]}
    lede={copy.appsLede[lang]}
  >
    <ul class="apps">
      {
        APPS.map((app) => (
          <li class="app">
            <div class="app-head">
              <h3 class="app-name">{app.name}</h3>
              <p class="app-status mono">{app.status[lang]}</p>
            </div>
            <div class="app-body">
              <p class="app-what">{app.what[lang]}</p>
              <ul class="chips app-stack">
                {app.stack.map((item) => <li class="chip mono">{item}</li>)}
              </ul>
              <p class="app-links">
                {app.url && (
                  <a class="link" href={app.url} rel="noopener" target="_blank">
                    {copy.visit[lang]} ↗
                  </a>
                )}
                {app.repo && (
                  <a class="link mono" href={app.repo} rel="noopener" target="_blank">
                    GitHub ↗
                  </a>
                )}
              </p>
            </div>
          </li>
        ))
      }
    </ul>
  </Section>

  <Section
    id="programa-2026"
    eyebrow={copy.nowEyebrow[lang]}
    title={STRATEGIC_PROGRAMME.title[lang]}
    lede={STRATEGIC_PROGRAMME.intro[lang]}
  >
    <ol class="programme">
      {
        STRATEGIC_PROGRAMME.projects.map((project, i) => (
          <li class="programme-item">
            <span class="programme-index mono">{String(i + 1).padStart(2, '0')}</span>
            <div>
              <h3 class="programme-title">{project.title[lang]}</h3>
              <p class="muted programme-body">{project.body[lang]}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </Section>
</BaseLayout>

<style>
  /* ---- Index ---- */
  .index ol {
    list-style: none;
    padding: 0;
    margin: 0;
    border-block-start: 1px solid var(--line);
    max-width: 52rem;
  }

  .index-link {
    display: grid;
    grid-template-columns: 2.5rem minmax(0, 1fr) auto;
    gap: 0.75rem;
    align-items: baseline;
    padding-block: 0.85rem;
    border-block-end: 1px solid var(--line);
    text-decoration: none;
    color: var(--ink-2);
    transition: color 0.18s var(--ease), padding-inline-start 0.18s var(--ease);
  }

  .index-link:hover {
    color: var(--accent-deep);
    padding-inline-start: 0.35rem;
  }

  .index-num {
    color: var(--accent);
    font-size: 0.72rem;
  }

  .index-text {
    font-size: var(--step--1);
    font-weight: 500;
  }

  .index-year {
    font-size: 0.72rem;
    color: var(--ink-3);
  }

  /* ---- Methods ---- */
  .methods {
    display: grid;
    gap: clamp(1.75rem, 1.3rem + 2vw, 2.75rem) clamp(1.75rem, 1.2rem + 2.5vw, 3.5rem);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 17rem), 1fr));
  }

  .method-title {
    font-family: var(--font-sans);
    font-size: var(--step-0);
    font-weight: 600;
    letter-spacing: 0;
    line-height: 1.35;
    padding-block-end: 0.8rem;
    border-block-end: 2px solid var(--accent);
  }

  .method-list {
    list-style: none;
    padding: 0;
    margin: 0.9rem 0 0;
    display: grid;
    gap: 0.55rem;
    font-size: var(--step--1);
    line-height: 1.55;
    color: var(--ink-2);
  }

  .method-list li {
    position: relative;
    padding-inline-start: 0.95rem;
  }

  .method-list li::before {
    content: '';
    position: absolute;
    inset-inline-start: 0;
    inset-block-start: 0.6em;
    width: 0.4rem;
    height: 1px;
    background: var(--line-strong);
  }

  /* ---- Project: metadata rail + one reading column ----
     Three equal columns of context / approach / outcome forced the eye to read
     in parallel and never aligned; this reads top-down at a single measure. */
  .project {
    display: grid;
    grid-template-columns: minmax(0, 15rem) minmax(0, 1fr);
    gap: clamp(1.5rem, 1rem + 3vw, 4rem);
    align-items: start;
    scroll-margin-block-start: 6rem;
  }

  .rail {
    position: sticky;
    top: 5.5rem;
  }

  .rail-period {
    color: var(--accent);
    font-size: 0.74rem;
    letter-spacing: 0.06em;
    padding-block-end: 0.7rem;
    border-block-end: 2px solid var(--accent);
  }

  .rail-org {
    margin-block-start: 0.8rem;
    font-size: var(--step--1);
    font-weight: 600;
    line-height: 1.45;
  }

  .rail-meta {
    margin: 1.5rem 0 0;
  }

  .rail-meta dt {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-3);
  }

  .rail-meta dd {
    margin: 0.45rem 0 1.25rem;
    font-size: 0.8rem;
    line-height: 1.55;
    color: var(--ink-2);
  }

  .rail-meta dd:last-child {
    margin-block-end: 0;
  }

  .project-title {
    font-size: var(--step-3);
    max-width: 26ch;
  }

  .project-tagline {
    margin-block-start: 1rem;
    max-width: 40rem;
  }

  .block {
    margin-block-start: clamp(1.75rem, 1.5rem + 1.4vw, 2.5rem);
    padding-block-start: clamp(1.25rem, 1.1rem + 0.8vw, 1.75rem);
    border-block-start: 1px solid var(--line-strong);
  }

  .block-title {
    font-family: var(--font-sans);
    font-size: var(--step-0);
    font-weight: 600;
    letter-spacing: 0;
    margin-block-end: 0.9rem;
  }

  .block-text,
  .outcomes {
    color: var(--ink-2);
    font-size: var(--step--1);
    line-height: 1.78;
    max-width: 42rem;
  }

  /* ---- Architecture flow ---- */
  .flow {
    list-style: none;
    padding: 0;
    margin: 0;
    max-width: 44rem;
    border-inline-start: 1px solid var(--accent-line);
  }

  .flow-step {
    position: relative;
    padding: 0 0 1.2rem 1.6rem;
  }

  .flow-step:last-child {
    padding-block-end: 0;
  }

  /* A node on the spine, so the block reads as a pipeline, not a bullet list. */
  .flow-step::before {
    content: '';
    position: absolute;
    inset-inline-start: -4.5px;
    inset-block-start: 0.42em;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 0 3px var(--paper);
  }

  .section.sunk .flow-step::before {
    box-shadow: 0 0 0 3px var(--paper-sunk);
  }

  .flow-stage {
    display: block;
    font-size: 0.7rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .flow-detail {
    display: block;
    margin-block-start: 0.4rem;
    color: var(--ink-2);
    font-size: var(--step--1);
    line-height: 1.7;
  }

  /* ---- Outcomes ---- */
  .outcomes {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0.8rem;
  }

  .outcomes li {
    position: relative;
    padding-inline-start: 1.3rem;
  }

  .outcomes li::before {
    content: '';
    position: absolute;
    inset-inline-start: 0;
    inset-block-start: 0.7em;
    width: 0.7rem;
    height: 2px;
    background: var(--accent);
  }

  /* ---- Chips ---- */
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .chip {
    padding: 0.16rem 0.5rem;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    color: var(--ink-2);
    font-size: 0.68rem;
    background: var(--surface);
  }

  /* ---- Evaluation table ---- */
  .table-wrap {
    overflow-x: auto;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--surface);
  }

  .table {
    width: 100%;
    min-width: 36rem;
    border-collapse: collapse;
    font-size: var(--step--1);
  }

  .table th,
  .table td {
    padding: 0.9rem 1.1rem;
    vertical-align: top;
    text-align: start;
    border-block-end: 1px solid var(--line);
  }

  .table thead th {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-3);
    background: var(--paper-sunk);
    white-space: nowrap;
  }

  .table tbody th {
    font-weight: 600;
    color: var(--ink);
    width: 12rem;
  }

  .metric-value {
    color: var(--accent-deep);
    font-size: var(--step-0);
    white-space: nowrap;
    font-variant-numeric: lining-nums tabular-nums;
  }

  .table tbody tr:last-child th,
  .table tbody tr:last-child td {
    border-block-end: 0;
  }

  /* ---- Applications ---- */
  .apps {
    list-style: none;
    padding: 0;
    margin: 0;
    border-block-start: 1px solid var(--line-strong);
  }

  .app {
    display: grid;
    grid-template-columns: minmax(0, 15rem) minmax(0, 1fr);
    gap: 0.5rem clamp(1.5rem, 1rem + 3vw, 4rem);
    padding-block: clamp(1.4rem, 1.2rem + 1vw, 2rem);
    border-block-end: 1px solid var(--line);
  }

  .app-name {
    font-size: var(--step-1);
    line-height: 1.3;
  }

  .app-status {
    margin-block-start: 0.4rem;
    font-size: 0.7rem;
    letter-spacing: 0.04em;
    color: var(--accent);
  }

  .app-what {
    color: var(--ink-2);
    font-size: var(--step--1);
    line-height: 1.7;
    max-width: 42rem;
  }

  .app-stack {
    margin-block-start: 0.9rem;
  }

  .app-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    margin-block-start: 0.9rem;
    font-size: var(--step--1);
  }

  /* ---- 2026 programme ---- */
  .programme {
    display: grid;
    gap: 1.5rem clamp(1.5rem, 1rem + 2vw, 2.75rem);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr));
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .programme-item {
    display: flex;
    gap: 0.85rem;
    padding-block-start: 1rem;
    border-block-start: 1px solid var(--line-strong);
  }

  .programme-index {
    color: var(--accent);
    font-size: 0.72rem;
    padding-block-start: 0.25rem;
    flex: none;
  }

  .programme-title {
    font-family: var(--font-sans);
    font-size: var(--step-0);
    font-weight: 600;
    letter-spacing: 0;
    line-height: 1.4;
  }

  .programme-body {
    font-size: var(--step--1);
    line-height: 1.6;
    margin-block-start: 0.3rem;
  }

  @media (max-width: 58rem) {
    .project,
    .app {
      grid-template-columns: 1fr;
    }

    .project {
      gap: 1.5rem;
    }

    .rail {
      position: static;
    }

    .rail-meta {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(min(100%, 12rem), 1fr));
      gap: 0 1.5rem;
      margin-block-start: 1.25rem;
    }
  }
</style>
