---
import { ROUTES, type Locale } from '@/i18n/config';
import { POSITIONS } from '@/data/notes';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/PageHeader.astro';
import Section from '@/components/Section.astro';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;

const copy = {
  metaTitle: { es: 'Notas técnicas', en: 'Technical notes' },
  metaDescription: {
    es: 'Cinco posiciones técnicas sobre datos en salud pública: sesgo de supervivencia en listas de espera, interoperabilidad semántica, supervisión humana obligatoria, gobernanza bajo la Ley 21.719 y reproducibilidad como rendición de cuentas.',
    en: 'Five technical positions on public health data: survivorship bias in waiting lists, semantic interoperability, mandatory human oversight, governance under Chile’s data protection law and reproducibility as accountability.',
  },
  eyebrow: { es: 'Notas técnicas', en: 'Technical notes' },
  title: {
    es: 'Cinco lecturas del problema que cambian el diseño del sistema',
    en: 'Five readings of the problem that change how the system is built',
  },
  lede: {
    es: 'Cada una de estas posiciones existe porque la lectura habitual del problema es común, cara y equivocada, y porque decidir distinto cambió algo concreto en un sistema que está corriendo. Al final de cada una está el sistema donde esa decisión se sostiene.',
    en: 'Each of these positions exists because the usual reading of the problem is common, costly and wrong, and because deciding otherwise changed something concrete in a system that is running. Each one ends with the system where that decision holds.',
  },
  appliesTo: { es: 'Dónde se sostiene', en: 'Where it holds' },
} as const;
---

<BaseLayout
  lang={lang}
  routeKey="notes"
  title={copy.metaTitle[lang]}
  description={copy.metaDescription[lang]}
>
  <PageHeader eyebrow={copy.eyebrow[lang]} title={copy.title[lang]} lede={copy.lede[lang]} />

  {
    POSITIONS.map((item, i) => (
      <Section sunk={i % 2 === 0} id={item.id}>
        <article class="position">
          <div class="position-head">
            <p class="position-index mono" aria-hidden="true">{String(i + 1).padStart(2, '0')}</p>
            <h2 class="position-title">{item.title[lang]}</h2>
            <p class="position-claim">{item.claim[lang]}</p>
          </div>

          <div class="position-body">
            {item.body[lang].map((paragraph) => <p>{paragraph}</p>)}

            <p class="applies">
              <span class="applies-label mono">{copy.appliesTo[lang]}</span>
              <a class="link" href={`${ROUTES.work[lang]}#${item.appliesTo}`}>
                {item.appliesToLabel[lang]}
              </a>
            </p>
          </div>
        </article>
      </Section>
    ))
  }
</BaseLayout>

<style>
  .position {
    display: grid;
    gap: 1.5rem clamp(2rem, 1.2rem + 3.5vw, 4.5rem);
    grid-template-columns: minmax(0, 21rem) minmax(0, 1fr);
    align-items: start;
    scroll-margin-block-start: 6rem;
  }

  .position-index {
    color: var(--accent);
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    margin-block-end: 0.6rem;
  }

  .position-title {
    font-size: var(--step-2);
    line-height: 1.2;
  }

  .position-claim {
    margin-block-start: 1rem;
    padding-block-start: 1rem;
    border-block-start: 2px solid var(--accent);
    font-family: var(--font-serif);
    font-style: italic;
    font-size: var(--step-1);
    line-height: 1.45;
    color: var(--accent-deep);
  }

  .position-body p {
    color: var(--ink-2);
    font-size: var(--step--1);
    line-height: 1.78;
    max-width: 40rem;
  }

  .position-body p + p {
    margin-block-start: 1.05em;
  }

  /* Anchors the argument to the system it was actually decided in. */
  .applies {
    margin-block-start: 1.75rem;
    padding-block-start: 1rem;
    border-block-start: 1px solid var(--line-strong);
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.35rem 0.8rem;
  }

  .applies-label {
    font-size: 0.7rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-3);
  }

  @media (max-width: 56rem) {
    .position {
      grid-template-columns: 1fr;
      gap: 1.25rem;
    }
  }
</style>
