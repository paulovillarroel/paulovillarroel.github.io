---
import { HTML_LANG, LOCALES, OG_LOCALE, ROUTES, type Locale, type RouteKey } from '@/i18n/config';
import { PERSON, SITE } from '@/data/site';

interface Props {
  lang: Locale;
  routeKey: RouteKey;
  title: string;
  description: string;
  /** Overrides the per-locale social card. */
  image?: string;
  /** Set on the 404 page so search engines do not index it. */
  noindex?: boolean;
}

const { lang, routeKey, title, description, image, noindex = false } = Astro.props;

const site = Astro.site ?? new URL(SITE.url);
const abs = (path: string) => new URL(path, site).href;

const canonical = abs(ROUTES[routeKey][lang]);
const ogImage = abs(image ?? `/og-${lang}.png`);

// Every page exists in both languages, so alternates are always complete.
const alternates = LOCALES.map((locale) => ({
  hreflang: HTML_LANG[locale],
  href: abs(ROUTES[routeKey][locale]),
}));

// The site title reads "Page — Paulo Villarroel" except on the home page,
// where the name should lead.
const fullTitle = routeKey === 'home' ? title : `${title} — ${PERSON.shortName}`;
---

<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />

{noindex && <meta name="robots" content="noindex, follow" />}
{!noindex && <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />}

{alternates.map(({ hreflang, href }) => <link rel="alternate" hreflang={hreflang} href={href} />)}
<link rel="alternate" hreflang="x-default" href={abs(ROUTES[routeKey].es)} />

<meta property="og:type" content="profile" />
<meta property="og:site_name" content={PERSON.name} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={PERSON.name} />
<meta property="og:locale" content={OG_LOCALE[lang]} />
{LOCALES.filter((l) => l !== lang).map((l) => <meta property="og:locale:alternate" content={OG_LOCALE[l]} />)}
<meta property="profile:first_name" content="Paulo" />
<meta property="profile:last_name" content="Villarroel Tapia" />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />

<meta name="author" content={PERSON.name} />
<meta name="theme-color" content="#0b5c63" />
