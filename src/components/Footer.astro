---
import { NAV_ORDER, ROUTES, type Locale } from '@/i18n/config';
import { ui } from '@/i18n/ui';
import { PERSON, SITE, SOCIALS } from '@/data/site';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const year = new Date(SITE.updated).getUTCFullYear();
---

<footer class="site-footer">
  <div class="shell">
    <div class="grid">
      <div class="brand">
        <p class="name">{PERSON.name}</p>
        <p class="muted role">{PERSON.jobTitle[lang]}</p>
        <p class="muted role">{PERSON.location[lang]}</p>
      </div>

      <nav aria-label={ui.footer.navigate[lang]}>
        <h2 class="col-title">{ui.footer.navigate[lang]}</h2>
        <ul>
          <li><a class="link" href={ROUTES.home[lang]}>{ui.nav.home[lang]}</a></li>
          {NAV_ORDER.map((key) => <li><a class="link" href={ROUTES[key][lang]}>{ui.nav[key][lang]}</a></li>)}
        </ul>
      </nav>

      <div>
        <h2 class="col-title">{ui.footer.elsewhere[lang]}</h2>
        <ul>
          {
            SOCIALS.map((social) => (
              <li>
                <a class="link" href={social.href} rel="me noopener" target="_blank">
                  {social.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div>
        <h2 class="col-title">{ui.footer.forAgents[lang]}</h2>
        <ul>
          <li><a class="link mono" href="/llms.txt">/llms.txt</a></li>
          <li><a class="link mono" href="/llms-full.txt">/llms-full.txt</a></li>
          <li><a class="link mono" href="/sitemap-index.xml">/sitemap-index.xml</a></li>
        </ul>
        <p class="agents-note muted">{ui.footer.agentsNote[lang]}</p>
      </div>
    </div>

    <hr class="rule" />

    <div class="baseline">
      <p class="muted">© {year} {PERSON.name}. {ui.footer.rights[lang]}</p>
      <p class="muted">
        <a class="link" href={SITE.repo} rel="noopener" target="_blank">{ui.footer.builtWith[lang]}</a>
      </p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    margin-block-start: auto;
    padding-block: clamp(2.5rem, 1.8rem + 3vw, 4rem) 2.5rem;
    background: var(--paper-sunk);
    border-block-start: 1px solid var(--line);
    font-size: var(--step--1);
  }

  .grid {
    display: grid;
    gap: clamp(1.75rem, 1rem + 3vw, 3rem);
    grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr));
    align-items: start;
  }

  .brand .name {
    font-family: var(--font-serif);
    font-size: var(--step-1);
    font-weight: 600;
    letter-spacing: -0.012em;
  }

  .role {
    margin-block-start: 0.2rem;
    max-width: 22rem;
  }

  .col-title {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-3);
    margin-block-end: 0.85rem;
  }

  ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0.5rem;
  }

  .agents-note {
    margin-block-start: 0.9rem;
    font-size: 0.78rem;
    line-height: 1.55;
    max-width: 20rem;
  }

  .rule {
    margin-block: clamp(2rem, 1.5rem + 2vw, 3rem) 1.5rem;
  }

  .baseline {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.5rem;
    justify-content: space-between;
  }
</style>
