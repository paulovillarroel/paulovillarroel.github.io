---
import type { Locale } from '@/i18n/config';
import type { Stat } from '@/data/profile';

interface Props {
  stats: Stat[];
  lang: Locale;
  /** Notes are useful on the home page but noisy in dense listings. */
  withNotes?: boolean;
}

const { stats, lang, withNotes = true } = Astro.props;
---

<dl class="stats" class:list={['stats', { bare: !withNotes }]}>
  {
    stats.map((stat) => (
      <div class="stat">
        <dt class="value">{stat.value[lang]}</dt>
        <dd class="label">{stat.label[lang]}</dd>
        {withNotes && <dd class="note muted">{stat.note[lang]}</dd>}
      </div>
    ))
  }
</dl>

<style>
  .stats {
    display: grid;
    gap: clamp(1.25rem, 0.8rem + 1.6vw, 2rem);
    grid-template-columns: repeat(auto-fit, minmax(11rem, 1fr));
    margin: 0;
  }

  .stat {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding-block-start: 0.9rem;
    border-block-start: 2px solid var(--accent);
  }

  .value {
    font-family: var(--font-serif);
    font-size: var(--step-3);
    font-weight: 600;
    line-height: 1;
    letter-spacing: -0.02em;
    color: var(--ink);
    font-variant-numeric: lining-nums tabular-nums;
  }

  .label {
    margin: 0;
    font-size: var(--step--1);
    font-weight: 600;
    color: var(--ink-2);
  }

  .note {
    margin: 0;
    font-size: 0.78rem;
    line-height: 1.55;
  }
</style>
